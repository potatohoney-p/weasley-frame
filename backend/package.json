{
    "name":  "weasley-frame-backend",
    "version":  "0.1.0",
    "description": "Fastify and Mastra backend for Weasley Frame",
    "license": "Apache-2.0",
    "author": "Weasley Contributors",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/potatohoney-p/weasley-frame.git",
        "directory": "backend"
    },
    "type":  "module",
    "private":  true,
    "scripts":  {
                    "dev":  "node ../scripts/with-root-env.mjs tsx watch src/index.ts",
                    "build":  "tsc",
                    "test": "node --import tsx --test tests/*.test.ts",
                    "start":  "node ../scripts/with-root-env.mjs node dist/index.js",
                    "mastra:dev":  "node ../scripts/with-root-env.mjs mastra dev"
                },
    "dependencies":  {
                         "@clerk/backend":  "^3.4.11",
                         "@fastify/cors":  "^11.0.0",
                         "@mastra/core":  "^1.36.0",
                         "@napi-rs/keyring":  "^1.3.0",
                         "@openrouter/ai-sdk-provider":  "^2.9.0",
                         "ai":  "^6.0.0",
                         "convex":  "^1.39.1",
                         "dotenv":  "^16.4.0",
                         "fastify":  "^5.0.0",
                         "fastify-plugin":  "^5.1.0",
                         "posthog-node":  "^5.35.1",
                         "resend":  "^6.12.3",
                         "zod":  "^4.4.3"
                     },
    "devDependencies":  {
                            "@types/node":  "^22.0.0",
                            "mastra":  "^1.10.0",
                            "tsx":  "^4.0.0",
                            "typescript":  "^5.0.0"
                        },
    "overrides":  {
                      "ws":  "^8.21.0",
                      "hono":  "^4.12.25",
                      "js-cookie":  "^3.0.7",
                      "@babel/core":  "^7.29.6",
                      "esbuild":  "^0.28.1",
                      "@hono/node-server": "2.0.12",
                      "undici": "6.28.0",
                      "ai": {
                          "@ai-sdk/gateway": "3.0.159",
                          "@ai-sdk/provider-utils": "4.0.40"
                      }
                  }
}
